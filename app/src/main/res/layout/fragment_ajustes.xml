<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".menu.AjustesFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/ajustesSubtitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"

            android:layout_marginTop="16dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"

            android:text="@string/ajustes_subtitle"
            android:textAlignment="center"
            android:fontFamily="@font/komika"/>

        <RadioGroup
            android:id="@+id/radioGroupMangaAnime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/ajustesSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radioManga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:theme="@style/CustomRadioButtonTheme"
                android:checked="true"
                android:fontFamily="@font/komika"
                android:textSize="20sp"
                android:text="@string/ajustes_select_manga" />

            <RadioButton
                android:id="@+id/radioAnime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:theme="@style/CustomRadioButtonTheme"
                android:fontFamily="@font/komika"
                android:textSize="20sp"
                android:text="@string/ajustes_select_anime" />
        </RadioGroup>

        <TextView
            android:id="@+id/hintTextChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radioGroupMangaAnime"

            android:text="@string/ajustes_max_cap_text"
            android:textSize="16sp"
            android:fontFamily="@font/komika" />

        <EditText
            android:id="@+id/textChapter"
            android:layout_width="150dp"
            android:layout_height="wrap_content"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hintTextChapter"

            android:ems="10"
            android:inputType="number"
            android:text="@string/ajustes_max_cap_default"
            android:textAlignment="center"
            android:textSize="20sp"
            android:fontFamily="@font/komika"/>

        <TextView
            android:id="@+id/textHintDifficult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textChapter"

            android:text="@string/ajustes_difficult_text"
            android:textSize="16sp"
            android:fontFamily="@font/komika"
            android:textAlignment="center"/>

        <LinearLayout
            android:id="@+id/layoutDifficult"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            app:layout_constraintTop_toBottomOf="@+id/textHintDifficult"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            >

            <CheckBox
                android:id="@+id/boxEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:buttonTint="@color/red"
                android:checked="true"
                android:text="@string/ajustes_difficult_easy"
                android:fontFamily="@font/komika"/>

            <CheckBox
                android:id="@+id/boxMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"

                android:buttonTint="@color/red"
                android:checked="true"
                android:text="@string/ajustes_difficult_medium"
                android:fontFamily="@font/komika"/>

            <CheckBox
                android:id="@+id/boxHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:buttonTint="@color/red"
                android:checked="true"
                android:text="@string/ajustes_difficult_hard"
                android:fontFamily="@font/komika" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            app:layout_constraintTop_toBottomOf="@+id/layoutDifficult"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"

            android:layout_marginTop="24dp"
            android:backgroundTint="@color/red"
            android:alpha="0.75"

            android:orientation="horizontal"
            android:gravity="center"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/ajustes_default"

                android:fontFamily="@font/komika"
                android:textAlignment="center"
                android:gravity="center"
                />

            <Button
                android:id="@+id/buttonDefault"
                android:layout_width="40dp"
                android:layout_height="46dp"

                android:layout_marginStart="12dp"
                android:backgroundTint="@color/red"
                android:textSize="14sp"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>